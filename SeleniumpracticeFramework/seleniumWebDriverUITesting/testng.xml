<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestAutomationPracticeSuite" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.ExtentTestNGListener"/>
        <listener class-name="com.automation.listeners.SuiteListener"/>
    </listeners>

    <!-- ====================== EDGE EXECUTION ======================= -->
    <test name="Edge_Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.automation.tests.PageTitleTest"/>
            <class name="com.automation.tests.AlertsPopupsTest"/>
            <class name="com.automation.tests.DownloadFilesTest"/>
        </classes>
    </test>

</suite>

